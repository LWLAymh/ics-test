{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lwlaymh.github.io/ics-test/schema/paper-v4.schema.json",
  "title": "ICS Test Paper v4 (design draft)",
  "type": "object",
  "required": ["schemaVersion", "id", "year", "academicYear", "term", "examKind", "sequence", "title", "sourceLabel", "sourceDocument", "questionIds", "questionCount", "verifiedAnswerCount", "complete"],
  "properties": {
    "schemaVersion": {"const": 4},
    "id": {"type": "string", "pattern": "^p-[a-f0-9]{16}$"},
    "year": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100},
    "academicYear": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}$"},
    "term": {"enum": ["spring", "fall", "summer", "winter", "unknown"]},
    "examKind": {"enum": ["midterm", "final", "stage-test", "quiz", "practice", "other"]},
    "sequence": {"type": ["integer", "null"], "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "sourceLabel": {"type": "string", "minLength": 1},
    "sourceDocument": {"type": "string", "minLength": 1},
    "questionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^q-[a-f0-9]{16}$"}},
    "questionCount": {"type": "integer", "minimum": 1},
    "verifiedAnswerCount": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"}
  },
  "additionalProperties": false
}
