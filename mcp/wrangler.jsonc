{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ics-test-mcp",
  "account_id": "d36b1aa688170ab636ac79a352af1caf",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
