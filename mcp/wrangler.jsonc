  "migrations": [{ "tag": "practice-session-v1", "new_sqlite_classes": ["PracticeSession"] }, { "tag": "curation-session-v1", "new_sqlite_classes": ["CurationSession"] }],
  "vars": {
    "SITE_URL": "https://lwlaymh.github.io/ics-test/",
