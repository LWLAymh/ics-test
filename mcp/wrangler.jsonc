  },
  "ratelimits": [
    { "name": "MCP_RATE_LIMITER", "namespace_id": "861001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ISSUE_RATE_LIMITER", "namespace_id": "861002", "simple": { "limit": 5, "period": 60 } },
    { "name": "SESSION_CREATE_RATE_LIMITER", "namespace_id": "861003", "simple": { "limit": 5, "period": 60 } }
  ]
